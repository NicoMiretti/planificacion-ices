# ─── Dockerfile de producción ───────────────────────────────────────────────
# Usa gunicorn, whitenoise para static y monta /app/media como PVC.
# No incluye herramientas de desarrollo ni el .venv local.

FROM python:3.12-slim

# Variables de entorno para Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings.docker

# Dependencias del sistema:
#   libpq-dev  → psycopg (postgres)
#   gcc        → compilar extensiones C de psycopg
#   libmagic1  → python-magic (validación de tipo de archivos Word)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Instalar dependencias de Python primero (mejor cache de capas)
COPY requirements/ requirements/
RUN pip install --no-cache-dir -r requirements/production.txt

# Copiar el código fuente
COPY . .

# Crear directorios necesarios
RUN mkdir -p /app/media /app/staticfiles

# Recolectar archivos estáticos durante el build
# SECRET_KEY dummy solo para este paso — no se usa en runtime
RUN SECRET_KEY=build-dummy-key-not-used-in-runtime \
    python manage.py collectstatic --noinput --clear

EXPOSE 8000

# Startup: migrate + gunicorn
# - workers: 2*CPU+1 (ajustar según recursos del contenedor)
# - timeout: 120s para uploads de archivos Word
# - access-logfile "-" → stdout (visible con docker logs)
CMD ["sh", "-c", \
     "python manage.py migrate --noinput && \
      gunicorn config.wsgi:application \
        --bind 0.0.0.0:8000 \
        --workers ${GUNICORN_WORKERS:-3} \
        --timeout ${GUNICORN_TIMEOUT:-120} \
        --access-logfile - \
        --error-logfile -"]
